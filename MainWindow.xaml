<Window x:Class="atsukibrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:atsukibrowser"
        Title="AtsukiBrowser" Height="720" Width="1280"
        Icon="icon.ico"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="#0A0A10"
        Background="#0A0A10"
        UseLayoutRounding="True">

<Window.Resources>
    <Style x:Key="MenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#aaaacc"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#2a1a4e"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <!-- Scrollbar estilo minimalista oscuro -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Bg" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#3a2a6a"
                                                    CornerRadius="3"
                                                    Margin="1,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#7c3aed"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#9d5aff"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="UrlBarStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#aaaacc"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="#7c3aed"/>
        <Setter Property="ContextMenu" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Window.Resources>

<WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34"
              ResizeBorderThickness="4"
              GlassFrameThickness="0"
              NonClientFrameEdges="None"
              UseAeroCaptionButtons="False"/>
</WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto" x:Name="GruposRow" MinHeight="0"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="52"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Marca de agua preview -->
        <TextBlock x:Name="MarcaAgua"
                Grid.Row="0" Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Estás en una preview — esta versión puede ser inestable"
                Foreground="#44ffffff"
                FontSize="10"
                FontFamily="Segoe UI"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                IsHitTestVisible="False"
                Panel.ZIndex="1"
                Visibility="Collapsed"/>

        <!-- Barra de pestañas (ocupa columnas 0 y 1) -->
        <Grid x:Name="TabBar" Grid.Row="0" Grid.ColumnSpan="2" 
            Background="#0A0A10" Height="38" MouseRightButtonDown="TabBar_MouseRightButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pestañas + botón nueva pestaña -->
            <Border x:Name="TabBarBorder" Grid.Column="0" BorderBrush="#1a1030" BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        <Button x:Name="BtnNewTab" Content="+"
                                Width="30" Height="30"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="BtnNewTab_Click"
                                Background="Transparent" Foreground="#555577"
                                BorderThickness="0" FontSize="18" Cursor="Hand"
                                VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Botones de ventana estilo Chrome -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Badge preview -->
                <Border x:Name="BadgePreview"
                        Background="Transparent"
                        BorderBrush="#7c3aed"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="PREVIEW"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#9d5aff"
                               FontFamily="Segoe UI"/>
                </Border>
                <Button x:Name="BtnMinimize" Content="─"
                        Width="46" Height="34"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnMinimize_Click"
                        Background="Transparent" Foreground="#666688"
                        BorderThickness="0" FontSize="12" Cursor="Hand"/>
                <Button x:Name="BtnMaximize" Content="□"
                        Width="46" Height="34"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnMaximize_Click"
                        Background="Transparent" Foreground="#666688"
                        BorderThickness="0" FontSize="12" Cursor="Hand"/>
                <Button x:Name="BtnClose" Content="✕"
                        Width="46" Height="34"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnClose_Click"
                        Background="Transparent" Foreground="#666688"
                        BorderThickness="0" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Fila de grupos de tabs -->
        <Border x:Name="GruposBar" 
                Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1"
                Height="32"
                Background="#0d0d14"
                BorderBrush="#1a1030"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                        VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="GruposStrip" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="8,0"/>
            </ScrollViewer>
        </Border>

        <!-- Barra de navegación (solo columna 1) -->
        <Grid x:Name="NavBar" Grid.Row="2" Grid.Column="1" Background="#12121C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botones nav -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,4,0">
                <Button x:Name="BtnBack" Width="30" Height="30"
                        Click="BtnBack_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Atrás">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M19 12H5M12 19l-7-7 7-7" 
                            Stroke="#555577" StrokeThickness="2" 
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnForward" Width="30" Height="30"
                        Click="BtnForward_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Adelante">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M5 12h14M12 5l7 7-7 7"
                            Stroke="#555577" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnReload" Width="30" Height="30"
                        Click="BtnReload_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Recargar">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                                Stroke="#555577" StrokeThickness="2"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M3 3v5h5"
                                Stroke="#555577" StrokeThickness="2"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- URL bar -->
            <Border x:Name="UrlBarBorder" Grid.Column="1" Background="#1A1A2E" CornerRadius="6"
                    Margin="4,6" BorderBrush="#3d2a6e" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="UrlAccentBar" Grid.Column="0" Background="#7c3aed"
                            CornerRadius="6,0,0,6"/>

                    <!-- Icono HTTPS — cambia según el protocolo -->
                    <Viewbox Grid.Column="1" Width="13" Height="13" Margin="8,0,4,0">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="UrlIconoPath"
                                Data="M12 2a5 5 0 0 1 5 5v3H7V7a5 5 0 0 1 5-5zM7 10h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z"
                                Fill="#444466"/>
                        </Canvas>
                    </Viewbox>

                    <!-- TextBox editable (visible al enfocar) -->
                    <TextBox Grid.Column="2" x:Name="UrlBar"
                        Style="{StaticResource UrlBarStyle}"
                        KeyDown="UrlBar_KeyDown"
                        TextChanged="UrlBar_TextChanged"
                        GotFocus="UrlBar_GotFocus"
                        LostFocus="UrlBar_LostFocus"
                        PreviewMouseRightButtonDown="UrlBar_MouseRightButtonDown"/>

                    <!-- TextBlock decorado (visible cuando no está en foco) -->
                    <TextBlock x:Name="UrlDisplay" Grid.Column="2"
                            VerticalAlignment="Center" Padding="4,0" FontSize="12"
                            Foreground="#aaaacc" IsHitTestVisible="True"
                            Cursor="IBeam" Visibility="Collapsed"
                            MouseDown="UrlDisplay_MouseDown"/>
                </Grid>
            </Border>

            <Popup x:Name="SugerenciasPopup"
                Grid.Column="1"
                PlacementTarget="{Binding ElementName=UrlBarBorder}"
                Placement="Bottom"
                StaysOpen="False"
                AllowsTransparency="True">
                <Border Background="#13131f"
                        BorderBrush="#2a1a4a"
                        BorderThickness="1"
                        CornerRadius="0,0,8,8"
                        MinWidth="400"
                        Focusable="False">
                    <ListBox x:Name="SugerenciasList"
                            Background="Transparent"
                            BorderThickness="0"
                            MaxHeight="320"
                            Foreground="White"
                            FontSize="14"
                            Padding="4"
                            Focusable="False"
                            MouseUp="SugerenciasList_MouseUp"
                            KeyDown="SugerenciasList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Foreground" Value="#ccccee"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a1a3a"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2a1a5a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                            Text="{Binding Icono}"
                                            FontSize="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}"
                                                FontSize="13"
                                                Foreground="#e0e0f0"/>
                                        <TextBlock Text="{Binding Subtitulo}"
                                                FontSize="11"
                                                Foreground="#7070a0"
                                                Margin="0,2,0,0"
                                                Visibility="{Binding Subtitulo, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- Botones derecha -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        Margin="4,0,8,0" VerticalAlignment="Center">
                <Button x:Name="BtnGo" Width="30" Height="30"
                        Click="BtnGo_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="M21 21l-4.35-4.35"
                                Stroke="#7c3aed" StrokeThickness="2"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"
                                Stroke="#7c3aed" StrokeThickness="2"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Zoom -->
                <Border Background="#1a1a2e" CornerRadius="4"
                        Margin="2,0" Padding="0" VerticalAlignment="Center"
                        BorderBrush="#3d2a6e" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnZoomOut" Content="−" Width="24" Height="26"
                                Click="BtnZoomOut_Click"
                                Background="Transparent" Foreground="#888899"
                                BorderThickness="0" FontSize="16" Cursor="Hand"/>
                        <TextBox x:Name="ZoomLabel" Text="100%" Width="44"
                                Foreground="#888899" FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextAlignment="Center" Cursor="IBeam"
                                KeyDown="ZoomLabel_KeyDown"
                                GotFocus="ZoomLabel_GotFocus"
                                LostFocus="ZoomLabel_LostFocus"/>
                        <Button x:Name="BtnZoomIn" Content="+" Width="24" Height="26"
                                Click="BtnZoomIn_Click"
                                Background="Transparent" Foreground="#888899"
                                BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Descargas -->
                <Button x:Name="BtnDescargas" Width="30" Height="30"
                        Click="BtnDescargas_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Descargas">
                    <Grid>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 3v13M5 16l7 7 7-7"
                                    Stroke="#555577" StrokeThickness="2"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M3 21h18"
                                    Stroke="#555577" StrokeThickness="2"
                                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <!-- Badge de descargas activas -->
                        <Border x:Name="BadgeDescargas"
                                Background="#7c3aed"
                                CornerRadius="6"
                                MinWidth="14" Height="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="BadgeDescargasText"
                                    Text="0"
                                    FontSize="9" FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="3,0"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Popup descargas recientes -->
                <Popup x:Name="PopupDescargas"
                    PlacementTarget="{Binding ElementName=BtnDescargas}"
                    Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#1E1E2E" BorderBrush="#7c3aed"
                            BorderThickness="1" CornerRadius="6"
                            Width="320" MaxHeight="400">
                        <StackPanel>
                            <!-- Header -->
                            <Border BorderBrush="#2a1a4e" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Descargas" Foreground="#7c3aed"
                                            FontSize="12" FontWeight="SemiBold"
                                            VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Ver todas →"
                                            x:Name="BtnVerDescargas"
                                            Click="BtnVerDescargas_Click"
                                            Background="Transparent" Foreground="#666688"
                                            BorderThickness="0" FontSize="11" Cursor="Hand"/>
                                </Grid>
                            </Border>
                            <!-- Lista -->
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ListaDescargasPopup" Margin="8,6"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="BtnFavorito" Width="30" Height="30"
                        Click="BtnFavorito_Click"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Favorito">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                            Stroke="#555577" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Fill="Transparent"
                            x:Name="PathFavorito"/>
                    </Viewbox>
                </Button>

                <Button x:Name="BtnAjustes" Width="30" Height="30"
                        Click="BtnAjustes_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Ajustes">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"
                            Stroke="#555577" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                    </Viewbox>
                </Button>

                <!-- Tres puntos -->
                <Button x:Name="BtnMenu" Width="30" Height="30"
                        Click="BtnMenu_Click" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="Menú">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M4 6h16M4 12h16M4 18h16"
                            Stroke="#555577" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                </Button>

                <!-- Popup tres puntos -->
                <Popup x:Name="PopupMenu"
                    PlacementTarget="{Binding ElementName=BtnMenu}"
                    Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#1E1E2E" BorderBrush="#3d2a6e"
                            BorderThickness="1" CornerRadius="6"
                            MinWidth="200" Padding="4">
                        <StackPanel>
                            <Button Content="📄  Nueva pestaña"        Click="BtnNewTab_Click"       Style="{StaticResource MenuItemStyle}"/>
                            <Button Content="⭐  Favoritos"             Click="BtnVerFavoritos_Click"  Style="{StaticResource MenuItemStyle}"/>
                            <Button Content="🕐  Historial"             Click="MenuHistorial_Click"    Style="{StaticResource MenuItemStyle}"/>
                            <Separator Background="#2a1a4e" Margin="8,2"/>
                            <Button Content="⚙  Ajustes"               Click="BtnAjustes_Click"       Style="{StaticResource MenuItemStyle}"/>
                            <Button Content="⚙  Ajustes"               Click="BtnAjustes_Click"       Style="{StaticResource MenuItemStyle}"/>
                            <Button Content="❓  Ayuda"                 Click="MenuAyuda_Click"         Style="{StaticResource MenuItemStyle}"/>
                            <Button Content="✦  Novedades"              Click="MenuNovedades_Click"     Style="{StaticResource MenuItemStyle}"/>
                            <Separator Background="#1a1030" Margin="8,4"/>
                            <TextBlock Text="PERFIL" Foreground="#444466" FontSize="9"
                                    Margin="12,6,0,2"/>
                            <Button x:Name="MenuPerfil" Style="{StaticResource MenuItemStyle}"
                                    Click="MenuPerfil_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="MenuPerfilEmoji" Text="⭐" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="MenuPerfilNombre" Text="Principal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="👥  Gestionar perfiles" Style="{StaticResource MenuItemStyle}"
                                    x:Name="MenuGestionarPerfiles" Click="MenuGestionarPerfiles_Click"/>
                            <Button Content="🕶  Modo invitado" Style="{StaticResource MenuItemStyle}"
                                    x:Name="MenuInvitado" Click="MenuInvitado_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- Popup favoritos -->
            <Popup x:Name="PopupFavoritos"
                PlacementTarget="{Binding ElementName=BtnFavorito}"
                Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#1E1E2E" BorderBrush="#7c3aed"
                        BorderThickness="1" CornerRadius="6"
                        MinWidth="280" MaxHeight="360">
                    <StackPanel>
                        <Border BorderBrush="#2a1a4e" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Favoritos" Foreground="#7c3aed"
                                        FontSize="12" FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Ver todos →"
                                        x:Name="BtnVerFavoritos"
                                        Click="BtnVerFavoritos_Click"
                                        Background="Transparent" Foreground="#666688"
                                        BorderThickness="0" FontSize="11" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ListaFavoritosPopup" Margin="6"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Sidebar izquierdo (filas 1 y 2, columna 0) -->
        <Border x:Name="Sidebar" Grid.Row="1" Grid.RowSpan="3" Grid.Column="0"
                Background="#0A0A10"
                BorderBrush="#1a1030" BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botones del sidebar (siempre visible) -->
                <DockPanel Grid.Column="0" VerticalAlignment="Stretch">
                    <StackPanel x:Name="SidebarBottom" DockPanel.Dock="Bottom" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SidebarTop" Margin="0,8,0,0"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- Panel de música (visible cuando está expandido) -->
                <Border x:Name="MusicaPanel" Grid.Column="1"
                        Background="#0d0d18"
                        BorderBrush="#1a1030" BorderThickness="1,0,0,0"
                        Visibility="Collapsed"
                        ClipToBounds="True">
                    <DockPanel Margin="12">

                        <!-- Header -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Música de fondo"
                                    FontSize="10" FontWeight="Bold"
                                    Foreground="#7c3aed"
                                    VerticalAlignment="Center"/>
                            <Button x:Name="BtnMusicaAjustes" Grid.Column="1"
                                    Content="⚙" Width="24" Height="24"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#555577" FontSize="13"
                                    Cursor="Hand" ToolTip="Ajustes de música"/>
                        </Grid>

                        <!-- Panel de ajustes de música -->
                        <Border x:Name="MusicaAjustesPanel" DockPanel.Dock="Top"
                                Background="#0a0a14" BorderBrush="#2a1a4a"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <!-- Fondo del panel -->
                                <TextBlock Text="FONDO DEL PANEL" FontSize="9"
                                        Foreground="#555577"
                                        Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" >
                                    <Button x:Name="BtnMusicaFondoArtwork" Content="Artwork"
                                            FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#7c3aed"
                                            Cursor="Hand"/>
                                    <Button x:Name="BtnMusicaFondoImagen" Content="Imagen"
                                            FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            Cursor="Hand"/>
                                    <Button x:Name="BtnMusicaFondoNinguno" Content="Ninguno"
                                            FontSize="10" Padding="6,3"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            Cursor="Hand"/>
                                </StackPanel>

                                <!-- Reproducir al inicio -->
                                <TextBlock Text="AL INICIAR" FontSize="9"
                                        Foreground="#555577"
                                        Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Reproducir al abrir"
                                            FontSize="11" Foreground="#aaaacc"
                                            VerticalAlignment="Center"/>
                                    <Button x:Name="BtnMusicaAutoplay" Grid.Column="1"
                                            Content="○" Width="32" Height="18"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            FontSize="10" Cursor="Hand"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Aleatorio de todas las playlists"
                                            FontSize="11" Foreground="#aaaacc"
                                            VerticalAlignment="Center"/>
                                    <Button x:Name="BtnMusicaAleatorioGlobal" Grid.Column="1"
                                            Content="○" Width="32" Height="18"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            FontSize="10" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Reanudar al abrir"
                                            FontSize="11" Foreground="#aaaacc"
                                            VerticalAlignment="Center"/>
                                    <Button x:Name="BtnMusicaContinuar" Grid.Column="1"
                                            Content="○" Width="32" Height="18"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            FontSize="10" Cursor="Hand"/>
                                </Grid>

                                <!-- Volumen por defecto -->
                                <TextBlock Text="VOLUMEN POR DEFECTO" FontSize="9"
                                        Foreground="#555577"
                                        Margin="0,4,0,6"/>
                                <Slider x:Name="MusicaVolumenDefault"
                                        Minimum="0" Maximum="1" Value="0.8"
                                        IsMoveToPointEnabled="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Tabs de playlists -->
                        <ScrollViewer DockPanel.Dock="Top"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    Margin="0,0,0,6">
                            <StackPanel x:Name="MusicaPlaylistTabs" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <!-- Imagen de la playlist activa -->
                        <Image x:Name="MusicaPlaylistImagen" DockPanel.Dock="Top"
                            Height="70" Stretch="UniformToFill"
                            Visibility="Collapsed" Margin="0,0,0,8">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,999,70" RadiusX="6" RadiusY="6"/>
                            </Image.Clip>
                        </Image>

                        <!-- Canción actual -->
                        <Border DockPanel.Dock="Top"
                                Background="#141320"
                                BorderBrush="#2a1a4a" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="MusicaTitulo"
                                        Text="Sin reproducción"
                                        FontSize="12" FontWeight="SemiBold"
                                        Foreground="White"
                                        TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MusicaAutor"
                                        Text=""
                                        FontSize="10"
                                        Foreground="#9966cc"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="0,2,0,0"/>
                                <TextBlock x:Name="MusicaInfo"
                                        Text="—"
                                        FontSize="10"
                                        Foreground="#555577"
                                        Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Barra de progreso -->
                        <Slider x:Name="MusicaProgreso"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,8"
                                Minimum="0" Maximum="1" Value="0"
                                Height="4"
                                IsMoveToPointEnabled="True"/>

                        <!-- Controles de reproducción -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                            <Button x:Name="BtnMusicaShuffle" Content="⇄" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#555577" FontSize="14" Cursor="Hand"/>
                            <Button x:Name="BtnMusicaAnterior" Content="⏮" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="14" Cursor="Hand" Margin="4,0"/>
                            <Button x:Name="BtnMusicaPlay" Content="▶" Width="36" Height="36"
                                    Background="#2a1a5a" BorderThickness="0"
                                    Foreground="White" FontSize="16" Cursor="Hand" Margin="4,0"/>
                            <Button x:Name="BtnMusicaSiguiente" Content="⏭" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="14" Cursor="Hand" Margin="4,0"/>
                            <Button x:Name="BtnMusicaRepeat" Content="↻" Width="28" Height="28"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#555577" FontSize="14" Cursor="Hand"/>
                            <!-- Botón aleatorio -->
                            <Button x:Name="BtnMusicaAleatorio" Content="⚡"
                                    ToolTip="Canción aleatoria"
                                    Width="28" Height="28" FontSize="13" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#555577" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Velocidad de reproducción -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" 
                                    Margin="0,0,0,6" HorizontalAlignment="Center">
                            <TextBlock Text="VELOCIDAD" FontSize="9" Foreground="#555577"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnVel05" Content="0.5x" Tag="0.5"
                                    FontSize="10" Padding="6,2" Cursor="Hand" Margin="0,0,2,0"
                                    Background="#1a0a3a" Foreground="#555577"
                                    BorderBrush="#2a1a4a" BorderThickness="1"/>
                            <Button x:Name="BtnVel1" Content="1x" Tag="1.0"
                                    FontSize="10" Padding="6,2" Cursor="Hand" Margin="0,0,2,0"
                                    Background="#2a1a5a" Foreground="White"
                                    BorderBrush="#7c3aed" BorderThickness="1"/>
                            <Button x:Name="BtnVel15" Content="1.5x" Tag="1.5"
                                    FontSize="10" Padding="6,2" Cursor="Hand" Margin="0,0,2,0"
                                    Background="#1a0a3a" Foreground="#555577"
                                    BorderBrush="#2a1a4a" BorderThickness="1"/>
                            <Button x:Name="BtnVel2" Content="2x" Tag="2.0"
                                    FontSize="10" Padding="6,2" Cursor="Hand"
                                    Background="#1a0a3a" Foreground="#555577"
                                    BorderBrush="#2a1a4a" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Volumen -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔈" FontSize="11" Foreground="#555577" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicaVolumen"
                                    Minimum="0" Maximum="1" Value="0.8"
                                    Width="160" Margin="6,0"
                                    IsMoveToPointEnabled="True"/>
                            <TextBlock Text="🔊" FontSize="11" Foreground="#555577" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Tabs Canciones / Playlists -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="BtnTabCanciones"
                                    Content="Canciones"
                                    FontSize="10" Padding="10,4" Cursor="Hand"
                                    Background="#2a1a5a" Foreground="White"
                                    BorderThickness="0" Margin="0,0,2,0"/>
                            <Button x:Name="BtnTabPlaylists"
                                    Content="Playlists"
                                    FontSize="10" Padding="10,4" Cursor="Hand"
                                    Background="#1a0a3a" Foreground="#555577"
                                    BorderThickness="0"/>
                        </StackPanel>

                        <!-- Panel Canciones -->
                        <DockPanel x:Name="PanelTabCanciones" DockPanel.Dock="Top" LastChildFill="True">

                            <!-- Header playlist + botones acción -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="PLAYLIST" FontSize="10"
                                        Foreground="#555577" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnMusicaNuevaPlaylist" Content="+ Lista"
                                            FontSize="10" Padding="5,3" Cursor="Hand" Margin="0,0,4,0"
                                            Background="#1a0a3a" Foreground="#9955BB"
                                            BorderBrush="#3D2A6E" BorderThickness="1"/>
                                    <Button x:Name="BtnMusicaAgregarArchivo" Content="+ Archivo"
                                            FontSize="10" Padding="5,3"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#7c3aed"
                                            Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnMusicaLimpiar" Content="Limpiar"
                                            FontSize="10" Padding="5,3"
                                            Background="#1a0a3a" BorderBrush="#2a1a4a"
                                            BorderThickness="1" Foreground="#555577"
                                            Cursor="Hand"/>
                                    <Button x:Name="BtnMusicaOrdenar" Content="⇅ Ordenar"
                                            FontSize="10" Padding="5,3" Cursor="Hand" Margin="0,0,4,0"
                                            Background="#1a0a3a" Foreground="#555577"
                                            BorderBrush="#2a1a4a" BorderThickness="1"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Export / Import -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnMusicaExportar" Content="↑ Exportar"
                                        FontSize="10" Padding="6,3" Cursor="Hand" Margin="0,0,4,0"
                                        Background="#1a0a3a" Foreground="#558855"
                                        BorderBrush="#2A4E2A" BorderThickness="1"/>
                                <Button x:Name="BtnMusicaImportar" Content="↓ Importar"
                                        FontSize="10" Padding="6,3" Cursor="Hand" Margin="0,0,4,0"
                                        Background="#1a0a3a" Foreground="#555588"
                                        BorderBrush="#2A2A4E" BorderThickness="1"/>
                                <Button x:Name="BtnMusicaFavoritos" Content="★ Favoritos"
                                        FontSize="10" Padding="6,3" Cursor="Hand"
                                        Background="#1a0a3a" Foreground="#555577"
                                        BorderBrush="#2a1a4a" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Búsqueda -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="MusicaBusqueda"
                                            Background="#0d0d18" BorderBrush="#2a1a4a"
                                            Foreground="White" FontSize="11"
                                            Padding="6,4" BorderThickness="1"/>
                                    <TextBlock Text="Buscar en playlist..."
                                            IsHitTestVisible="False"
                                            Foreground="#444466" FontSize="11"
                                            Padding="7,5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=MusicaBusqueda}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="BtnMusicaBusquedaClear" Content="✕"
                                        Grid.Column="1" Width="24"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#555577" FontSize="11"
                                        Cursor="Hand" Margin="2,0,0,0"
                                        Visibility="Collapsed"/>
                            </Grid>

                            <!-- Stream input -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MusicaStreamInput"
                                        Grid.Column="0"
                                        Background="#0d0d18" BorderBrush="#2a1a4a"
                                        Foreground="White" FontSize="11"
                                        Padding="6,4" BorderThickness="1"/>
                                <Button x:Name="BtnMusicaAddStream" Content="+"
                                        Grid.Column="1" Width="28"
                                        Background="#1a0a3a" BorderBrush="#2a1a4a"
                                        BorderThickness="1" Foreground="#7c3aed"
                                        FontSize="16" Cursor="Hand" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Lista de canciones con scroll -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MusicaPlaylist"/>
                            </ScrollViewer>

                        </DockPanel>

                        <!-- Panel Playlists -->
                        <ScrollViewer x:Name="PanelTabPlaylists"
                                    DockPanel.Dock="Top"
                                    Visibility="Collapsed"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MusicaPlaylistsPanel" Margin="0,4,0,0"/>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Popup buscador rápido del sidebar -->
        <Popup x:Name="PopupBuscadorSidebar"
            Grid.Row="1" Grid.RowSpan="3" Grid.Column="0"
            Placement="Right" StaysOpen="True"
            AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1E1E2E" BorderBrush="#3d2a6e"
                    BorderThickness="1" CornerRadius="0,8,8,0"
                    Padding="10,8" MinWidth="240">
                <StackPanel>
                    <TextBlock Text="Búsqueda rápida"
                            Foreground="#7c3aed" FontSize="10"
                            TextOptions.TextFormattingMode="Display"
                            Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SidebarBuscadorInput"
                                Grid.Column="0"
                                Background="#13131f" Foreground="White"
                                BorderBrush="#3d2a6e" BorderThickness="1"
                                Padding="8,6" FontSize="12"
                                CaretBrush="#7c3aed"
                                KeyDown="SidebarBuscador_KeyDown"/>
                        <Button Grid.Column="1" Content="→"
                                x:Name="SidebarBuscadorBtn"
                                Click="SidebarBuscador_Click"
                                Background="#7c3aed" Foreground="White"
                                BorderThickness="0" FontSize="14"
                                Width="30" Cursor="Hand" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup vista previa de pestaña -->
        <Popup x:Name="PopupPreviewTab"
            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Placement="Bottom" StaysOpen="False"
            AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1E1E2E" BorderBrush="#3d2a6e"
                    BorderThickness="1" CornerRadius="6"
                    Padding="6">
                <StackPanel>
                    <TextBlock x:Name="PreviewTabTitulo"
                            Foreground="White" FontSize="11"
                            MaxWidth="240" TextTrimming="CharacterEllipsis"
                            Margin="0,0,0,6"/>
                    <Image x:Name="PreviewTabImagen"
                        Width="240" Height="135"
                        Stretch="UniformToFill"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Contenedor WebView (fila 2, columna 1) -->
        <Grid x:Name="BrowserContainer" Grid.Row="3" Grid.Column="1"/>
    </Grid>
</Window>